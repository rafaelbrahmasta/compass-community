# ============================================================
# COMPASS Backend — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Database
DATABASE_URL=postgres://compass:compass123@localhost:5432/compass_db

# JWT
JWT_SECRET=ganti_dengan_secret_panjang_dan_acak_minimal_32_karakter

# SMTP (untuk email reminder)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=COMPASS <your_email@gmail.com>

# Admin default (seed awal)
ADMIN_EMAIL=admin@compass.id
ADMIN_PASSWORD=admin123

# Upload
UPLOAD_DIR=./uploads

# CORS — URL frontend
FRONTEND_URL=http://localhost:5173

# Server port
PORT=8080

# Demo Seeder (set true hanya di dev lokal untuk seed akun admin1/2 & anggota dummy)
SEED_DEMO=false
