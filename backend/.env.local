# ============================================================
# COMPASS Backend — Environment Variables (Development)
# ============================================================

# Database
DATABASE_URL=postgres://compass:compass123@localhost:5433/compass_db

# JWT
JWT_SECRET=compass_dev_secret_sangat_panjang_dan_aman_untuk_jwt_2026

# SMTP (gunakan Mailtrap atau akun SMTP nyata)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=COMPASS <noreply@compass.id>

# Admin default (akan di-seed otomatis saat pertama kali run)
ADMIN_EMAIL=admin@compass.id
ADMIN_PASSWORD=Admin@compass123

# Upload directory (relatif dari binary atau absolute)
UPLOAD_DIR=./uploads

# CORS
FRONTEND_URL=http://localhost:5173

# Server port
PORT=8080

# Demo Seeder
SEED_DEMO=true
